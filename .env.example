DATABASE_URL=postgresql://t2vpn:CHANGE_ME@localhost:5432/t2vpn?schema=public
AUTH_SECRET=GENERATE_A_RANDOM_64_CHARACTER_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_UNIQUE_PASSWORD

# Optional Android V2 integration. Never add real secrets to Git.
MOBILE_PROVISIONING_ENABLED=false
TELEMETRY_INGEST_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
PLAY_PLUS_PRODUCT_IDS=

# Production data safety: existing deployments should keep true (default).
# Set false only while initializing a completely new empty database.
REQUIRE_EXISTING_DATA=true
