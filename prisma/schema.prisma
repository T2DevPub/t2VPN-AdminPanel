generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model VpnServer {
  id          String       @id @default(cuid())
  name        String
  country     String
  countryCode String
  city        String       @default("")
  host        String       @unique
  deployedOn  String       @default("")
  region      String?
  tier        String       @default("FREE")
  visibility  String       @default("BOTH")
  freeProfile Int          @default(1)
  plusProfile Int          @default(1)
  enabled     Boolean      @default(true)
  profiles    VpnProfile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model VpnProfile {
  id                String    @id @default(cuid())
  serverId          String
  server            VpnServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  slot              Int
  protocol          String
  port              Int
  usernameEncrypted String
  passwordEncrypted String
  ovpnEncrypted     String    @db.Text
  fileName          String

  @@unique([serverId, slot])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  detail    String?
  createdAt DateTime @default(now())
}


model AppInstallation {
  id String @id @default(cuid())
  installationId String @unique
  deviceModel String @default("")
  manufacturer String @default("")
  androidVersion String @default("")
  appVersion String @default("")
  countryCode String @default("")
  plan String @default("FREE")
  subscriptionExpiresAt DateTime?
  revoked Boolean @default(false)
  publicKeySpki String? @db.Text
  rewardedUntil DateTime?
  subscriptionCheckedAt DateTime?
  subscriptionTokenHash String? @unique
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  sessions VpnUsageSession[]
  events InstallationEvent[]
}

model InstallationEvent {
  id String @id @default(cuid())
  installationId String
  installation AppInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  kind String
  countryCode String @default("")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([installationId, createdAt])
}

model VpnUsageSession {
  id String @id @default(cuid())
  installationId String
  installation AppInstallation @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  serverId String
  connectedAt DateTime @default(now())
  disconnectedAt DateTime?
  lastHeartbeatAt DateTime?
  bytesIn BigInt @default(0)
  bytesOut BigInt @default(0)
  outcome String @default("CONNECTED")
  @@index([installationId, connectedAt])
  @@index([serverId, connectedAt])
  @@index([disconnectedAt, lastHeartbeatAt])
}

model MobileAuthChallenge {
  id String @id @default(uuid())
  installationId String
  publicKeySpki String @db.Text
  nonce String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([installationId, expiresAt])
}
model MobileRewardPending {
  id String @id @default(uuid())
  installationId String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([installationId, expiresAt])
}
model MobileRewardReceipt {
  transactionId String @id
  installationId String
  adUnit String
  createdAt DateTime @default(now())
}
model MobileRateLimit {
  key String @id
  windowStart DateTime
  hits Int @default(0)
}
